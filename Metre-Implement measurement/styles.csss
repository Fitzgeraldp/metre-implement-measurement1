body {
            text-align: center;
            font-family: Arial, sans-serif;
        }

        input {
            padding: 10px;
            font-size: 16px;
            width: 200px;
            margin-bottom: 20px;
        }

        button {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
        }

        #result {
            margin-top: 20px;
        }

        h2 {
            margin-bottom: 10px;
        }
